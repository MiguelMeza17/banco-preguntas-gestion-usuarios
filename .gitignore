# Base de datos SQLite local
*.db

# Salida de compilación (sin Maven: la genera el Language Support for Java de VS Code)
bin/

# Compiled class files
*.class

# IDEs
.idea/
*.iml
# .vscode/ se ignora completo excepto settings.json: ahí vive la configuración de
# classpath manual (java.project.referencedLibraries) que reemplaza al pom.xml —
# sin ese archivo el proyecto no compila al abrirlo en una máquina nueva.
.vscode/*
!.vscode/settings.json
nb-configuration.xml
nbproject/private/
.settings/
.classpath
.project

# Logs
*.log

# Sistema operativo
.DS_Store
Thumbs.db
